# Data Provider API Keys (optional - system uses free sources by default)
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# Supabase Storage & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ML_SERVICE_URL is injected by the Vercel service binding for app -> ml.
# Do not set it manually. `vercel dev` injects it for local multi-service runs.
ML_SERVICE_API_KEY=

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NODE_ENV=development
